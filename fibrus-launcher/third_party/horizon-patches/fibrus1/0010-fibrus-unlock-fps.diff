+/// `FIBRUS_UNLOCK_FPS` as the launcher writes it: only `1` turns the frame cap off.
+fn unlock_fps_from(value: Option<&str>) -> bool {
+    value.is_some_and(|v| v.trim() == "1")
+}
+
 impl Settings {
+    /// Fibrus: the launcher asked for no frame cap at all (`FIBRUS_UNLOCK_FPS=1`, read once). It does what a
+    /// player's Max Framerate "Unlimited" never did on a phone: VSync stays on after that, and VSync is the display's
+    /// own rate (60 on most phones), and battery mode adds its own cap of 60 and the throttles of a window out of
+    /// focus. Nothing is written to options.txt for it, so turning it off in the launcher gives the saved settings back.
+    pub fn fibrus_unlock(&self) -> bool {
+        static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        *ON.get_or_init(|| unlock_fps_from(std::env::var("FIBRUS_UNLOCK_FPS").ok().as_deref()))
+    }
+
+    /// No VSync and no frame cap: Horizon's own Max FPS mode, or Fibrus's switch for the same.
+    pub fn uncapped(&self) -> bool {
+        self.extras.max_fps_mode || self.fibrus_unlock()
+    }
+
     /// The index in `video_modes` of the preferred fullscreen mode, -1 (the desktop's own mode)
     /// when none is set or the monitor lacks it: `Monitor.indexOfMode`.
     pub fn video_mode_index(&self) -> i32 {
@@ -933,6 +952,26 @@ pub enum Opt {
 mod tests {
     use super::*;
     #[test]
+    fn only_a_one_unlocks_the_frame_cap_and_max_fps_mode_alone_does_too() {
+        // The launcher's switch: anything but 1 leaves the player's own settings.
+        for (value, on) in [
+            (Some("1"), true),
+            (Some(" 1\n"), true),
+            (Some("0"), false),
+            (Some(""), false),
+            (Some("true"), false),
+            (None, false),
+        ] {
+            assert_eq!(unlock_fps_from(value), on, "{value:?}");
+        }
+        // Without the switch (the test process has none) VSync and the cap follow Horizon's own Max FPS mode.
+        let mut s = Settings::default();
+        assert!(!s.fibrus_unlock());
+        assert!(!s.uncapped());
+        s.extras.max_fps_mode = true;
+        assert!(s.uncapped());
+    }
+    #[test]
     fn the_narrator_reads_its_status_and_the_voice_under_master() {
         let s = Settings::parse("narrator:2\nsoundCategory_master:0.5\nsoundCategory_voice:0.5\n");
         assert_eq!(s.narrator(), horizon_narrator::Status::Chat);
