<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- Starling memakai Vulkan; tidak wajib supaya APK tetap terpasang di HP tanpa Vulkan (mesin akan menolak jalan). -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fibrus"
        android:requestLegacyExternalStorage="true"
        android:allowNativeHeapPointerTagging="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|smallestScreenSize|density|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Mesin Rust Starling (MIT). Kelas-kelas dev.horizon.android.* TIDAK ada di repo: dipasang saat build bersama
            libstarling_android.so oleh scripts/fetch-horizon-engine.sh. Tanpa itu activity ini tidak pernah dibuka
            (StarlingLauncher.availability() menolaknya lebih dulu). Nama kelas terikat pada fungsi JNI di pustaka native:
            jangan diganti. Proses :starling sendiri karena mesin memanggil process::exit saat selesai.
        -->
        <activity
            android:name="dev.horizon.android.GameActivity"
            android:exported="false"
            android:process=":starling"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:theme="@style/StarlingGameTheme"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|density|screenSize|smallestScreenSize|layoutDirection|colorMode|fontWeightAdjustment|grammaticalGender"
            tools:ignore="MissingClass">
            <meta-data android:name="android.app.lib_name" android:value="starling_android" />
            <meta-data android:name="android.app.func_name" android:value="starling_on_create" />
        </activity>

        <!-- Memulai ulang game di proses baru (mis. setelah penyiapan pertama). -->
        <activity
            android:name="dev.horizon.android.LauncherActivity"
            android:exported="false"
            android:process=":launcher"
            android:taskAffinity="${applicationId}.launcher"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            tools:ignore="MissingClass" />

        <activity
            android:name="dev.horizon.android.DiagnosticsActivity"
            android:exported="false"
            android:process=":diagnostics"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:hardwareAccelerated="false"
            tools:ignore="MissingClass" />

        <!-- Menjaga Starling di latar depan saat unduhan sumber daya atau penyiapan berjalan. -->
        <service
            android:name="dev.horizon.android.WorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:ignore="MissingClass" />
    </application>
</manifest>
