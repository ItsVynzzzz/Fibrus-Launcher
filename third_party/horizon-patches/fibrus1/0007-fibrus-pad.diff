+        assert!(p.lit(Btn::Jump));
+        assert_eq!(toks(&p.touch(S, 3, Phase::Up, x, y, 9)), vec![("key.keyboard.space", false)]);
+
+        let (x, y) = center(Btn::Sneak);
+        assert_eq!(toks(&p.touch(S, 4, Phase::Down, x, y, 0)), vec![(KEY_SNEAK, true)]);
+        assert!(toks(&p.touch(S, 4, Phase::Up, x, y, 9)).is_empty());
+        assert!(p.lit(Btn::Sneak), "stays on after the finger lifts");
+        assert_eq!(toks(&p.touch(S, 5, Phase::Down, x, y, 20)), vec![(KEY_SNEAK, false)]);
+        p.touch(S, 5, Phase::Up, x, y, 29);
+        assert!(!p.busy());
+    }
+
+    #[test]
+    fn button_beats_view_and_stick_and_buttons_do_not_overlap() {
+        for a in BUTTONS {
+            for b in BUTTONS {
+                if a != b {
+                    let (ra, rb) = (S.rect(a), S.rect(b));
+                    let apart = ra[0] + ra[2] <= rb[0] || rb[0] + rb[2] <= ra[0] || ra[1] + ra[3] <= rb[1] || rb[1] + rb[3] <= ra[1];
+                    assert!(apart, "{a:?} overlaps {b:?}");
+                }
+            }
+            let r = S.rect(a);
+            assert!(r[0] >= 0.0 && r[1] >= 0.0 && r[0] + r[2] <= S.w && r[1] + r[3] <= S.h, "{a:?} off screen");
+        }
+    }
+
+    #[test]
+    fn hotbar_picks_the_slot_under_the_finger() {
+        let mut p = Pad::new(1.0);
+        let h = S.hotbar();
+        let mid = h[0] + h[2] / 2.0;
+        assert_eq!(toks(&p.touch(S, 1, Phase::Down, mid, S.h - 20.0, 0)), vec![("key.keyboard.5", true)]);
+        assert_eq!(toks(&p.touch(S, 1, Phase::Up, mid, S.h - 20.0, 5)), vec![("key.keyboard.5", false)]);
+        let first = toks(&p.touch(S, 2, Phase::Down, h[0] + 2.0, S.h - 20.0, 9));
+        assert_eq!(first, vec![("key.keyboard.1", true)]);
+        p.release_all();
+        let last = toks(&p.touch(S, 3, Phase::Down, h[0] + h[2] - 1.0, S.h - 20.0, 9));
+        assert_eq!(last, vec![("key.keyboard.9", true)]);
+    }
