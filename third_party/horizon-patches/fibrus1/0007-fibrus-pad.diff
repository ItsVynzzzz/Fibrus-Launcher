+    #[test]
+    fn release_all_lets_go_of_everything() {
+        let mut p = Pad::new(1.0);
+        p.touch(S, 1, Phase::Down, 300.0, 700.0, 0);
+        p.touch(S, 1, Phase::Move, 300.0, 540.0, 5);
+        let (x, y) = center(Btn::Jump);
+        p.touch(S, 2, Phase::Down, x, y, 6);
+        let (x, y) = center(Btn::Sneak);
+        p.touch(S, 3, Phase::Down, x, y, 7);
+        p.touch(S, 3, Phase::Up, x, y, 8);
+        p.touch(S, 4, Phase::Down, 1500.0, 300.0, 9);
+        p.tick(9 + HOLD_MS);
+        assert!(p.busy());
+        let o = toks(&p.release_all());
+        for t in [KEY_W, KEY_SPRINT, "key.keyboard.space", KEY_SNEAK, MOUSE_LEFT] {
+            assert!(o.contains(&(t, false)), "{t} not released: {o:?}");
+        }
+        assert!(o.iter().all(|(_, down)| !down));
+        assert!(!p.busy());
+        assert!(toks(&p.release_all()).is_empty());
+    }
