+    fn toks(o: &Out) -> Vec<(Token, bool)> {
+        o.tokens().to_vec()
+    }
+    fn center(b: Btn) -> (f32, f32) {
+        let r = S.rect(b);
+        (r[0] + r[2] / 2.0, r[1] + r[3] / 2.0)
+    }
+
+    #[test]
+    fn stick_walks_and_sprints_and_lets_go() {
+        let mut p = Pad::new(1.0);
+        assert!(toks(&p.touch(S, 1, Phase::Down, 300.0, 700.0, 0)).is_empty());
+        // u = 3, radius 138 px: 0.3 of it is 41 px.
+        assert!(toks(&p.touch(S, 1, Phase::Move, 300.0, 680.0, 10)).is_empty());
+        assert_eq!(toks(&p.touch(S, 1, Phase::Move, 300.0, 640.0, 20)), vec![(KEY_W, true)]);
+        // diagonal: right too
+        assert_eq!(toks(&p.touch(S, 1, Phase::Move, 360.0, 640.0, 30)), vec![(KEY_D, true)]);
+        // far forward: sprint (1.05 R = 145 px)
+        assert_eq!(toks(&p.touch(S, 1, Phase::Move, 300.0, 540.0, 40)), vec![(KEY_D, false), (KEY_SPRINT, true)]);
+        let up = toks(&p.touch(S, 1, Phase::Up, 300.0, 540.0, 50));
+        assert_eq!(up, vec![(KEY_W, false), (KEY_SPRINT, false)]);
+        assert!(!p.busy());
+    }
+
+    #[test]
+    fn stick_centre_follows_a_runaway_finger() {
+        let mut p = Pad::new(1.0);
+        p.touch(S, 1, Phase::Down, 300.0, 700.0, 0);
+        p.touch(S, 1, Phase::Move, 300.0, 100.0, 10);
+        let (c, f, r) = p.stick(S).unwrap();
+        let d = ((f[0] - c[0]).powi(2) + (f[1] - c[1]).powi(2)).sqrt();
+        assert!(d <= r * STICK_FOLLOW + 0.5, "{d}");
+    }
+
+    #[test]
+    fn tap_uses_and_releases_next_tick() {
+        let mut p = Pad::new(1.0);
+        p.touch(S, 7, Phase::Down, 1500.0, 300.0, 0);
+        let up = toks(&p.touch(S, 7, Phase::Up, 1500.0, 301.0, 100));
+        assert_eq!(up, vec![(MOUSE_RIGHT, true)]);
+        assert_eq!(toks(&p.tick(116)), vec![(MOUSE_RIGHT, false)]);
+        assert!(!p.busy());
+    }
+
+    #[test]
+    fn rest_mines_until_lifted() {
+        let mut p = Pad::new(1.0);
+        p.touch(S, 7, Phase::Down, 1500.0, 300.0, 0);
+        assert!(toks(&p.tick(100)).is_empty());
+        assert_eq!(toks(&p.tick(HOLD_MS)), vec![(MOUSE_LEFT, true)]);
+        assert!(toks(&p.tick(HOLD_MS + 16)).is_empty());
+        assert_eq!(toks(&p.touch(S, 7, Phase::Up, 1500.0, 300.0, 600)), vec![(MOUSE_LEFT, false)]);
+    }
+
+    #[test]
+    fn drag_turns_and_never_clicks() {
+        let mut p = Pad::new(1.0);
+        p.touch(S, 7, Phase::Down, 1500.0, 300.0, 0);
+        let a = p.touch(S, 7, Phase::Move, 1503.0, 300.0, 5);
+        assert_eq!(a.look, (0.0, 0.0), "inside the slop");
+        let b = p.touch(S, 7, Phase::Move, 1560.0, 310.0, 10);
+        assert_eq!(b.look, (57.0, 10.0));
+        let c = p.touch(S, 7, Phase::Move, 1570.0, 310.0, 15);
+        assert_eq!(c.look, (10.0, 0.0));
+        assert!(toks(&p.tick(HOLD_MS + 50)).is_empty(), "a turning finger never starts mining");
+        assert!(toks(&p.touch(S, 7, Phase::Up, 1570.0, 310.0, 900)).is_empty());
+    }
